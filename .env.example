# ──────────────────────────────────────────────────────────────────────────────
# OMS Sentinel Environment Configuration Template
# Copy this file to .env and fill in your custom values.
# ──────────────────────────────────────────────────────────────────────────────

# Operator & Server Identity
OSM_OPERATOR=Prajan
PORT=8000
HOST=0.0.0.0

# Cloud API Connectivity (Leave empty for purely local operation)
OMS_CLOUD_API_URL=https://your-oms-api.onrender.com
OMS_API_KEY=your_secure_random_api_key_here

# Frontend Cloud API Endpoint (Configured on Render Static Site or Next.js)
NEXT_PUBLIC_OMS_API_URL=https://your-oms-api.onrender.com

# Telegram Bot Alerts (Optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_SPAM_COOLDOWN=300
